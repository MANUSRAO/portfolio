{% from "macros/icon.njk" import icon %}
{% from "macros/tag.njk" import tag %}
<article class="flex flex-col rounded-xl border border-line bg-surface p-6 transition-transform duration-200 hover:-translate-y-0.5">
  {% if item.image %}
    <img
      src="{{ item.image }}"
      alt="{{ item.name }} screenshot"
      width="1200"
      height="630"
      class="mb-5 w-full rounded-lg border border-line object-cover"
      loading="lazy"
      decoding="async"
    />
  {% endif %}

  <div class="flex items-start justify-between gap-4">
    <h3 class="text-[15px] font-semibold tracking-tight">{{ item.name }}</h3>
    <div class="flex shrink-0 items-center gap-1">
      {% if item.github %}
        <a
          href="{{ item.github }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ item.name }} on GitHub"
          title="GitHub"
          class="grid size-8 place-items-center rounded-lg border border-line text-muted transition-colors hover:text-ink"
        >{{ icon("github", 15) }}</a>
      {% endif %}
      {% if item.live %}
        <a
          href="{{ item.live }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open {{ item.name }}"
          title="Live site"
          class="grid size-8 place-items-center rounded-lg border border-line text-muted transition-colors hover:text-ink"
        >{{ icon("external", 15) }}</a>
      {% endif %}
    </div>
  </div>

  <p class="mt-3 text-[13.5px] leading-[1.75] text-muted">{{ item.description }}</p>

  {% if item.tech.length %}
    <div class="mt-4 flex flex-wrap gap-1.5">
      {% for tech in item.tech %}{{ tag(tech) }}{% endfor %}
    </div>
  {% endif %}
</article>
