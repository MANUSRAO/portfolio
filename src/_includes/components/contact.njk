{% from "macros/icon.njk" import icon %}
{% set blurbs = {
  "GitHub": "Code & open source",
  "LinkedIn": "Let's connect professionally",
  "X (Twitter)": "Thoughts & updates"
} %}

<section id="contact" class="mt-16">
  <h2 class="font-mono text-[13px] tracking-[0.14em] text-muted uppercase">Contact</h2>

  <p class="mt-3 max-w-xl text-[14px] leading-[1.8] text-muted">
    Happy to talk about anything related to tech, product or opportunities.
  </p>

  <div class="mt-5 grid gap-3 sm:grid-cols-2">
    <div class="relative flex flex-col gap-3">
      {% for social in socials %}
        {% include "components/social-card.njk" %}
      {% endfor %}

      {#- Sits on top of the LinkedIn and X cards, centred on the gap between them:
          on their left edge where the page margin has room (lg+), else on the right. #}
      {% if profile.resume %}
        <a
          href="{{ profile.resume }}"
          download="Manu_S_Rao_Resume.pdf"
          aria-label="Download résumé (PDF)"
          title="Download résumé"
          class="group absolute top-[calc(66.667%-50px)] right-11 z-20 lg:right-auto lg:-left-[76px] size-[104px] rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-muted focus-visible:ring-offset-4 focus-visible:ring-offset-canvas"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="-50 -50 100 100"
            class="size-full drop-shadow-[0_6px_12px_rgb(0_0_0/0.18)] transition-transform duration-300 group-hover:scale-[1.06] group-focus-visible:scale-[1.06]"
            aria-hidden="true"
            focusable="false"
          >
            <defs>
              <path id="resume-badge-ring" d="M0 -33.5a33.5 33.5 0 1 1 0 67a33.5 33.5 0 1 1 0 -67" />
            </defs>
            <path d="M0.00 -44.00A6.6 6.6 0 0 1 11.39 -42.50A6.6 6.6 0 0 1 22.00 -38.11A6.6 6.6 0 0 1 31.11 -31.11A6.6 6.6 0 0 1 38.11 -22.00A6.6 6.6 0 0 1 42.50 -11.39A6.6 6.6 0 0 1 44.00 -0.00A6.6 6.6 0 0 1 42.50 11.39A6.6 6.6 0 0 1 38.11 22.00A6.6 6.6 0 0 1 31.11 31.11A6.6 6.6 0 0 1 22.00 38.11A6.6 6.6 0 0 1 11.39 42.50A6.6 6.6 0 0 1 0.00 44.00A6.6 6.6 0 0 1 -11.39 42.50A6.6 6.6 0 0 1 -22.00 38.11A6.6 6.6 0 0 1 -31.11 31.11A6.6 6.6 0 0 1 -38.11 22.00A6.6 6.6 0 0 1 -42.50 11.39A6.6 6.6 0 0 1 -44.00 0.00A6.6 6.6 0 0 1 -42.50 -11.39A6.6 6.6 0 0 1 -38.11 -22.00A6.6 6.6 0 0 1 -31.11 -31.11A6.6 6.6 0 0 1 -22.00 -38.11A6.6 6.6 0 0 1 -11.39 -42.50A6.6 6.6 0 0 1 0.00 -44.00Z" fill="var(--c-accent)" />
            <text class="font-mono" font-size="8.2" font-weight="600" fill="var(--c-accent-ink)">
              <textPath href="#resume-badge-ring" textLength="208" lengthAdjust="spacing">DOWNLOAD RÉSUMÉ • DOWNLOAD RÉSUMÉ •</textPath>
            </text>
            <circle r="21" fill="var(--c-accent-ink)" />
            <g
              fill="none"
              stroke="var(--c-accent)"
              stroke-width="2.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform duration-200 group-hover:translate-y-[1.5px]"
            >
              <path d="M0 -9.5V4.5" />
              <path d="M-5.5 -1 0 4.5l5.5-5.5" />
              <path d="M-7.5 10h15" />
            </g>
          </svg>
        </a>
      {% endif %}
    </div>

    <div class="rounded-xl border border-line bg-surface p-5 sm:p-6">
      <h3 class="text-[14px] font-semibold tracking-tight">Send a message</h3>
      <p class="mt-1.5 text-[12.5px] text-muted">Opens your mail app, ready to send.</p>

      <form
        data-mailto-form
        data-mailto="{{ profile.email }}"
        action="mailto:{{ profile.email }}"
        method="post"
        enctype="text/plain"
        class="mt-5 flex flex-col gap-4"
      >
        <div class="flex flex-col gap-2">
          <label for="contact-subject" class="font-mono text-[10px] tracking-[0.14em] text-muted uppercase">Subject</label>
          <input
            id="contact-subject"
            name="subject"
            type="text"
            required
            autocomplete="off"
            placeholder="What's this about?"
            class="w-full rounded-lg border border-line bg-canvas px-3.5 py-3 text-[13.5px] text-ink transition-colors placeholder:text-muted focus:border-muted focus:ring-1 focus:ring-muted focus:outline-none"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="contact-message" class="font-mono text-[10px] tracking-[0.14em] text-muted uppercase">Message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="6"
            required
            placeholder="Tell me a bit about it…"
            class="h-[148px] w-full resize-none overflow-y-auto rounded-lg border border-line bg-canvas px-3.5 py-3 text-[13.5px] leading-[1.6] text-ink transition-colors placeholder:text-muted focus:border-muted focus:ring-1 focus:ring-muted focus:outline-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-ink px-4 py-3 text-[13px] font-medium text-canvas transition-opacity hover:opacity-90"
        >
          {{ icon("mail", 15) }} Send message
        </button>
      </form>
    </div>
  </div>
</section>
