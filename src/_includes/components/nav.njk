{% from "macros/icon.njk" import icon %}
<header class="site-header sticky top-0 z-50" data-header>
  <div class="mx-auto flex min-h-16 max-w-4xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-2 sm:px-6 sm:py-0">
    <nav class="flex flex-wrap items-center gap-x-0.5 gap-y-0.5" aria-label="Main">
      {% for item in site.nav %}
        {% if item.label !== "Blog" or collections.posts.length %}
          <a
            href="{{ item.href }}"
            class="rounded-lg px-2 py-1.5 text-[13px] font-medium text-muted transition-colors hover:bg-surface hover:text-ink sm:px-3 sm:py-2 sm:text-[13.5px]"
          >{{ item.label }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <button
      type="button"
      data-theme-toggle
      class="grid size-8 shrink-0 place-items-center text-muted transition-colors hover:text-ink"
      aria-label="Toggle theme"
    >
      <span class="flex dark:hidden">{{ icon("moon", 17) }}</span>
      <span class="hidden dark:flex">{{ icon("sun", 17) }}</span>
    </button>
  </div>
</header>
