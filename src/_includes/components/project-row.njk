{% from "macros/icon.njk" import icon %}
{% from "macros/tag.njk" import tag %}
<article class="rounded-xl border border-line bg-surface p-5 sm:p-6">
  <div class="{% if item.image %}flex flex-col gap-5 sm:flex-row sm:items-start sm:gap-6{% endif %}">
    {% if item.image %}
      <img
        src="{{ item.image }}"
        alt="{{ item.name }} screenshot"
        width="1280"
        height="800"
        class="aspect-[16/10] w-full shrink-0 rounded-lg border border-line object-cover object-left-top sm:w-72"
        loading="lazy"
        decoding="async"
      />
    {% endif %}

    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-4">
        <h2 class="text-[15px] font-semibold tracking-tight">{{ item.name }}</h2>

        {% if item.github or item.live %}
          <div class="flex shrink-0 items-center gap-4">
            {% if item.github %}
              <a
                href="{{ item.github }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="{{ item.name }} on GitHub"
                title="GitHub"
                class="text-muted transition-colors hover:text-ink"
              >{{ icon("github", 18) }}</a>
            {% endif %}
            {% if item.live %}
              <a
                href="{{ item.live }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Open {{ item.name }}"
                title="Live site"
                class="text-muted transition-colors hover:text-ink"
              >{{ icon("external", 18) }}</a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <p class="mt-2 text-[13.5px] leading-[1.75] text-muted">{{ item.description }}</p>

      {% if item.tech.length %}
        <div class="mt-4 flex flex-wrap gap-1.5">
          {% for tech in item.tech %}{{ tag(tech) }}{% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</article>
