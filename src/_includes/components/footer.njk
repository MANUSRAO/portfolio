{% from "macros/icon.njk" import icon %}
<footer class="relative z-10 mt-20 border-t border-line">
  <div class="mx-auto flex max-w-4xl flex-col gap-6 px-4 py-8 sm:flex-row sm:items-center sm:justify-between sm:gap-4 sm:px-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
      <p class="font-mono text-[11.5px] text-muted">
        © {{ "" | year }} {{ profile.name }}
      </p>
      <p class="font-mono text-[11.5px] text-muted">
        <span data-clock>{{ "" | istTime }}</span> · Bangalore
      </p>
    </div>

    <div class="flex items-center gap-3">
      {% for social in socials %}
        <a
          href="{{ social.url }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ social.label }}"
          title="{{ social.label }}"
          class="text-muted transition-colors hover:text-ink"
        >{{ icon(social.icon, 17) }}</a>
      {% endfor %}
    </div>
  </div>
</footer>
