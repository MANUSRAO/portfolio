{% from "macros/tag.njk" import tag %}
<div class="relative pb-10 pl-6">
  <span
    class="absolute {% if lineFromTop %}top-0{% else %}top-[13px]{% endif %} {% if lineLast %}bottom-[30px]{% else %}bottom-0{% endif %} left-0 w-px -translate-x-1/2 bg-line"
    aria-hidden="true"
  ></span>
  <span
    class="absolute top-1.5 left-0 size-2 -translate-x-1/2 rounded-full {% if dotAccent %}bg-accent{% else %}bg-muted{% endif %}"
    aria-hidden="true"
  ></span>

  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
    <h3 class="text-[15px] font-semibold tracking-tight">{{ item.role }}</h3>
    <span class="font-mono text-[11px] text-muted">{{ item.period }}</span>
  </div>

  <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[13px] text-muted">
    {% if item.companyUrl %}
      <a href="{{ item.companyUrl }}" target="_blank" rel="noopener noreferrer" class="font-medium text-ink hover:underline">{{ item.company }}</a>
    {% else %}
      <span class="font-medium text-ink">{{ item.company }}</span>
    {% endif %}
    <span aria-hidden="true">·</span>
    <span>{{ item.location }}</span>
    {% if item.type %}
      <span aria-hidden="true">·</span>
      <span>{{ item.type }}</span>
    {% endif %}
  </div>

  <ul class="mt-3.5 space-y-2">
    {% for bullet in item.bullets %}
      <li class="flex gap-2.5 text-[13.5px] leading-[1.7] text-muted">
        <span class="mt-[0.6em] size-1 shrink-0 rounded-full bg-line" aria-hidden="true"></span>
        <span>{{ bullet }}</span>
      </li>
    {% endfor %}
  </ul>

  {% if item.tech.length %}
    <div class="mt-3.5 flex flex-wrap gap-1.5">
      {% for tech in item.tech %}{{ tag(tech) }}{% endfor %}
    </div>
  {% endif %}
</div>
