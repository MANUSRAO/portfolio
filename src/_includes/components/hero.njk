{% from "macros/icon.njk" import icon %}
<section class="pt-12 pb-2 sm:pt-16">
  <div class="flex items-center gap-4">
    <img
      src="{{ profile.avatar }}"
      alt="{{ profile.name }}"
      width="72"
      height="72"
      class="size-16 shrink-0 rounded-xl border border-line object-cover sm:size-[72px]"
    />
    <div class="min-w-0">
      <h1 class="hover-underline inline-block text-2xl font-semibold tracking-tight sm:text-[2rem]">{{ profile.name }}</h1>
      <p class="mt-0.5 text-[14px] text-muted">{{ profile.tagline }}</p>
    </div>
  </div>

  <dl class="mt-9 flex flex-wrap items-start gap-x-8 gap-y-4">
    <div>
      <dt class="font-mono text-[10px] tracking-[0.14em] text-muted uppercase">Location</dt>
      <dd class="mt-1 flex items-center gap-2 text-[14px] font-medium">
        {{ icon("pin", 13, "shrink-0 text-muted") }}{{ profile.location }}
      </dd>
    </div>
    <div>
      <dt class="font-mono text-[10px] tracking-[0.14em] text-muted uppercase">Email</dt>
      <dd class="mt-1">
        <a
          href="mailto:{{ profile.email }}"
          class="group flex items-center gap-2 text-[14px] font-medium"
        >
          {{ icon("mail", 13, "shrink-0 text-muted") }}
          <span class="underline decoration-line underline-offset-4 group-hover:decoration-ink">{{ profile.email }}</span>
        </a>
      </dd>
    </div>
    <div>
      <dt class="font-mono text-[10px] tracking-[0.14em] text-muted uppercase">Status</dt>
      <dd class="mt-1 flex items-center gap-2 text-[14px] font-medium">
        <span class="size-1.5 rounded-full bg-accent"></span>{{ profile.available }}
      </dd>
    </div>
  </dl>

  <p class="mt-8 max-w-2xl text-[14.5px] leading-[1.85] text-muted">{{ profile.bio }}</p>

  <div class="mt-7 flex items-center gap-5">
    {% for social in socials %}
      <a
        href="{{ social.url }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{ social.label }}"
        title="{{ social.label }}"
        class="text-muted transition-colors hover:text-ink"
      >{{ icon(social.icon, 19) }}</a>
    {% endfor %}
  </div>
</section>
