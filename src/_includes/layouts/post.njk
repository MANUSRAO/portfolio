---
layout: layouts/base.njk
---
{% from "macros/icon.njk" import icon %}
<article class="mx-auto max-w-3xl px-6 py-12">
  <a
    href="/blog/"
    class="inline-flex items-center gap-1.5 font-mono text-[11.5px] text-muted transition-colors hover:text-ink"
  >
    {{ icon("arrow-left", 13) }} All posts
  </a>

  <h1 class="mt-6 text-2xl font-semibold tracking-tight sm:text-[2rem]">{{ title }}</h1>

  <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11.5px] text-muted">
    <span class="flex items-center gap-2">{{ icon("calendar", 12) }}{{ page.date | readableDate }}</span>
    {% if tags.length %}
      <span aria-hidden="true">·</span>
      <span>{{ tags | join(", ") }}</span>
    {% endif %}
  </div>

  {% if cover %}
    <img
      src="{{ cover }}"
      alt=""
      width="1200"
      height="630"
      class="mt-8 w-full rounded-xl border border-line object-cover"
    />
  {% endif %}

  <div class="prose-post mt-8">{{ content | safe }}</div>

  <div class="mt-12 border-t border-line pt-6">
    <a href="/blog/" class="inline-flex items-center gap-1.5 font-mono text-[11.5px] text-muted transition-colors hover:text-ink">
      {{ icon("arrow-left", 13) }} Back to all posts
    </a>
  </div>
</article>
